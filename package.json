  "description": "Unified real-time token telemetry engine and floating desktop pet companion across Claude Code, Codex CLI, Antigravity, Hermes Agent, Kilo, and Grok.",
  "main": "dist/index.js",
  "bin": {
    "starlight-pet": "./bin/starlight-pet.js",
    "fleet-hud": "./bin/starlight-pet.js",
    "agent-pet": "./bin/starlight-pet.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node dist/index.js",
    "cli": "node bin/starlight-pet.js",
